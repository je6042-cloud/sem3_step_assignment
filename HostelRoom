import java.util.Scanner;

abstract class HostelRoom {
    double units;

    HostelRoom(double units) {
        this.units = units;
    }

    abstract double calculateBill();
}

class SingleRoomBill extends HostelRoom {
    SingleRoomBill(double units) {
        super(units);
    }

    double calculateBill() {
        return units * 8;
    }
}

class SharedRoomBill extends HostelRoom {
    int occupants;

    SharedRoomBill(double units, int occupants) {
        super(units);
        this.occupants = occupants;
    }

    double calculateBill() {
        return (units * 6) / occupants;
    }
}

class ACRoomBill extends HostelRoom {
    ACRoomBill(double units) {
        super(units);
    }

    double calculateBill() {
        return units * 10 + 200;
    }
}

public class HostelElectricityCalculator {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        double total = 0;

        for (int i = 0; i < n; i++) {
            String type = sc.next();

            HostelRoom room;

            if (type.equals("SINGLE")) {
                double units = sc.nextDouble();
                room = new SingleRoomBill(units);

            } else if (type.equals("SHARED")) {
                double units = sc.nextDouble();
                int occupants = sc.nextInt();
                room = new SharedRoomBill(units, occupants);

            } else {
                double units = sc.nextDouble();
                room = new ACRoomBill(units);
            }

            double bill = room.calculateBill();

            System.out.printf("%s: %.2f%n", type, bill);
            total += bill;
        }

        System.out.printf("Total: %.2f%n", total);
    }
}
