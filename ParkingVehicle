import java.util.Scanner;

abstract class ParkingVehicle {
    int hours;

    ParkingVehicle(int hours) {
        this.hours = hours;
    }

    abstract double calculateCharge();
}

class BikeVehicle extends ParkingVehicle {
    BikeVehicle(int hours) {
        super(hours);
    }

    double calculateCharge() {
        return hours * 10;
    }
}

class CarVehicle extends ParkingVehicle {
    CarVehicle(int hours) {
        super(hours);
    }

    double calculateCharge() {
        return 30 + (hours - 1) * 20;
    }
}

class TruckVehicle extends ParkingVehicle {
    TruckVehicle(int hours) {
        super(hours);
    }

    double calculateCharge() {
        return Math.max(100, hours * 50);
    }
}

public class CampusParkingCalculator {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        double total = 0;

        for (int i = 0; i < n; i++) {
            String type = sc.next();
            int hours = sc.nextInt();

            ParkingVehicle vehicle;

            if (type.equals("BIKE"))
                vehicle = new BikeVehicle(hours);
            else if (type.equals("CAR"))
                vehicle = new CarVehicle(hours);
            else
                vehicle = new TruckVehicle(hours);

            double charge = vehicle.calculateCharge();

            System.out.printf("%s: %.2f%n", type, charge);
            total += charge;
        }

        System.out.printf("Total: %.2f%n", total);
    }
}
