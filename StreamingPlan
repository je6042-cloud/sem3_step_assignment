import java.util.Scanner;
import java.time.LocalDate;

abstract class StreamingPlan {
    String name;
    LocalDate startDate;

    StreamingPlan(String name, LocalDate startDate) {
        this.name = name;
        this.startDate = startDate;
    }

    abstract LocalDate calculateRenewalDate();
}

class BasicStreamingPlan extends StreamingPlan {
    BasicStreamingPlan(String name, LocalDate startDate) {
        super(name, startDate);
    }

    LocalDate calculateRenewalDate() {
        return startDate.plusDays(30);
    }
}

class StandardStreamingPlan extends StreamingPlan {
    StandardStreamingPlan(String name, LocalDate startDate) {
        super(name, startDate);
    }

    LocalDate calculateRenewalDate() {
        return startDate.plusDays(90);
    }
}

class PremiumStreamingPlan extends StreamingPlan {
    PremiumStreamingPlan(String name, LocalDate startDate) {
        super(name, startDate);
    }

    LocalDate calculateRenewalDate() {
        return startDate.plusDays(365);
    }
}

public class StreamingRenewalCalculator {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {
            String type = sc.next();
            String name = sc.next();
            LocalDate startDate = LocalDate.parse(sc.next());

            StreamingPlan plan;

            if (type.equals("BASIC"))
                plan = new BasicStreamingPlan(name, startDate);
            else if (type.equals("STANDARD"))
                plan = new StandardStreamingPlan(name, startDate);
            else
                plan = new PremiumStreamingPlan(name, startDate);

            LocalDate renewalDate = plan.calculateRenewalDate();

            System.out.println(name + ": " + renewalDate);
        }
    }
}
