import java.util.Scanner;

abstract class FestivalEmployee {
    String name;
    double salary;

    FestivalEmployee(String name, double salary) {
        this.name = name;
        this.salary = salary;
    }

    abstract double calculateBonus();
}

class FullTimeFestivalEmployee extends FestivalEmployee {
    FullTimeFestivalEmployee(String name, double salary) {
        super(name, salary);
    }

    double calculateBonus() {
        return salary * 0.10;
    }
}

class PartTimeFestivalEmployee extends FestivalEmployee {
    PartTimeFestivalEmployee(String name, double salary) {
        super(name, salary);
    }

    double calculateBonus() {
        return salary * 0.05;
    }
}

class InternFestivalEmployee extends FestivalEmployee {
    InternFestivalEmployee(String name, double salary) {
        super(name, salary);
    }

    double calculateBonus() {
        return 2000;
    }
}

public class FestivalBonusCalculator {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        double totalBonus = 0;

        for (int i = 0; i < n; i++) {
            String type = sc.next();
            String name = sc.next();
            double salary = sc.nextDouble();

            FestivalEmployee employee;

            if (type.equals("FULLTIME"))
                employee = new FullTimeFestivalEmployee(name, salary);
            else if (type.equals("PARTTIME"))
                employee = new PartTimeFestivalEmployee(name, salary);
            else
                employee = new InternFestivalEmployee(name, salary);

            double bonus = employee.calculateBonus();

            System.out.printf("%s: %.2f%n", name, bonus);
            totalBonus += bonus;
        }

        System.out.printf("Total Bonus: %.2f%n", totalBonus);
    }
}
